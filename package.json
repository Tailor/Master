{
  "name": "master",
  "version": "2.0.3",
  "description": "The command center for the Master framework — a Next.js-style CLI that scaffolds and runs decoupled full-stack apps (Next.js frontend + MasterController API + MasterRecord ORM). By the power of Grayskull!",
  "type": "module",
  "bin": {
    "master": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "templates/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "master",
    "mastercontroller",
    "masterrecord",
    "cli",
    "scaffolding",
    "generator",
    "nextjs",
    "fullstack",
    "mvc",
    "orm",
    "framework",
    "rails-like",
    "create-app",
    "monorepo",
    "esm"
  ],
  "homepage": "https://github.com/Tailor/Master#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tailor/Master.git"
  },
  "bugs": {
    "url": "https://github.com/Tailor/Master/issues"
  },
  "author": "Alexandr Rich",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.2",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.8"
  }
}
